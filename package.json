{
  "name": "inox-tools",
  "displayName": "Horizon Mod Tools (Inox)",
  "description": "Make Horizon mods in VS Code: content mods (.hmod), native mixin and API mods (.hnmod) and Inox mods (.imod). Checks and autocomplete for every manifest and data file, hook-point names, run in the game like a dev build, build, check and install.",
  "version": "0.2.0",
  "publisher": "xmilon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xmilon/INOX-Mod-Loader-VSCode-Extension"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "horizon",
    "minecraft",
    "mod",
    "hmod",
    "hnmod",
    "inox",
    "imod",
    "mixin"
  ],
  "main": "./src/extension.js",
  "extensionDependencies": [
    "tamasfe.even-better-toml"
  ],
  "activationEvents": [
    "workspaceContains:inox.toml",
    "workspaceContains:*/inox.toml",
    "workspaceContains:horizon-mod.toml",
    "workspaceContains:*/horizon-mod.toml",
    "workspaceContains:horizon-mixin.toml",
    "workspaceContains:*/horizon-mixin.toml",
    "onCommand:inox.newMod",
    "onDebugResolve:inox",
    "onDebugDynamicConfigurations:inox",
    "onDebugInitialConfigurations"
  ],
  "contributes": {
    "commands": [
      {
        "command": "inox.run",
        "title": "Run in Horizon",
        "category": "Horizon",
        "icon": "$(play)"
      },
      {
        "command": "inox.build",
        "title": "Build Mod (.hmod / .hnmod / .imod)",
        "category": "Horizon",
        "icon": "$(package)"
      },
      {
        "command": "inox.install",
        "title": "Build and Install into Horizon",
        "category": "Horizon"
      },
      {
        "command": "inox.check",
        "title": "Check Mod (as the registry does)",
        "category": "Horizon"
      },
      {
        "command": "inox.newMod",
        "title": "New Mod",
        "category": "Horizon"
      },
      {
        "command": "inox.pickResources",
        "title": "Choose the Game Resources",
        "category": "Horizon"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "inox.run",
          "when": "resourceFilename =~ /^(inox|horizon-mod|horizon-mixin).toml$/",
          "group": "navigation@0"
        }
      ],
      "editor/title": [
        {
          "command": "inox.build",
          "when": "resourceFilename =~ /^(inox|horizon-mod|horizon-mixin).toml$/",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "inox.build",
        "key": "ctrl+f9",
        "mac": "cmd+f9",
        "when": "resourceFilename =~ /^(inox|horizon-mod|horizon-mixin).toml$/"
      }
    ],
    "taskDefinitions": [
      {
        "type": "inox",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    ],
    "debuggers": [
      {
        "type": "inox",
        "label": "Horizon (mod)",
        "languages": [
          "toml"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "mod"
            ],
            "properties": {
              "mod": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "The mod's folder (horizon-mod.toml or inox.toml), loaded with --dev-mod: no build needed."
              },
              "world": {
                "type": "string",
                "default": "Mod Test",
                "description": "The world to open or create in the run folder; none starts at the title screen."
              },
              "creative": {
                "type": "boolean",
                "default": true,
                "description": "A new world in creative mode."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "More arguments for horizon-client (--seed 123, --width 1600...)."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "description": "Environment variables for the game."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "inox",
            "request": "launch",
            "name": "Run in Horizon",
            "mod": "${workspaceFolder}",
            "world": "Mod Test",
            "creative": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Horizon: Run a mod",
            "description": "Run the mod in Horizon, in the run/ folder",
            "body": {
              "type": "inox",
              "request": "launch",
              "name": "Run in Horizon",
              "mod": "^\"\\${workspaceFolder}\"",
              "world": "Mod Test",
              "creative": true
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Horizon Mod Tools",
      "properties": {
        "inox.client": {
          "type": "string",
          "default": "${env:APPDATA}/horizon/inox-indev/horizon-client.exe",
          "markdownDescription": "The Horizon client of the **Inox fork**, for Inox mods (`.imod`). `${env:NAME}` and `~` are expanded."
        },
        "inox.resources": {
          "type": "string",
          "default": "",
          "markdownDescription": "The prepared game resources (`.../.local/horizon-client/26.3`). Empty: picked from the launcher's prepared versions on the first run, then kept here. **Inox: Choose the Game Resources** picks again."
        },
        "inox.launcherDir": {
          "type": "string",
          "default": "${env:APPDATA}/horizon-launcher",
          "markdownDescription": "The Horizon launcher's data folder, where prepared versions are looked for."
        },
        "inox.gameDir": {
          "type": "string",
          "default": "${workspaceFolder}/run",
          "markdownDescription": "The game folder runs use (worlds, options, logs), away from your real game. `${workspaceFolder}` is the mod's folder."
        },
        "inox.installDir": {
          "type": "string",
          "default": "${env:APPDATA}/horizon/horizon-mods",
          "markdownDescription": "Where **Build and Install** copies content (`.hmod`) and Inox (`.imod`) mods: your game folder's `horizon-mods`."
        },
        "inox.cargoHorizonMod": {
          "type": "string",
          "default": "cargo horizon-mod",
          "markdownDescription": "The `cargo horizon-mod` command that makes, builds and checks content and Inox mods."
        },
        "inox.horizonClient": {
          "type": "string",
          "default": "",
          "markdownDescription": "The **official** Horizon client (`horizon-client.exe` of a version the launcher installed, under `horizon-launcher/versions/<version>/`) that **content mods** (`.hmod`) run in. `${env:NAME}` and `~` are expanded."
        },
        "inox.nativeInstallDir": {
          "type": "string",
          "default": "${env:APPDATA}/horizon/horizon-native-mods",
          "markdownDescription": "Where **Build and Install** copies native mods (`.hnmod`): your game folder's `horizon-native-mods`. The launcher builds the game with them."
        },
        "inox.horizonRevision": {
          "type": "string",
          "default": "",
          "pattern": "^([0-9a-f]{40})?$",
          "markdownDescription": "The Horizon commit (40 hex digits) new native mods are made for: written in their `[compatibility] horizon_revision`, which building an `.hnmod` needs."
        },
        "inox.horizonSource": {
          "type": "string",
          "default": "",
          "markdownDescription": "A Horizon checkout with `crates/horizon-mod-api`: new API mods point their `horizon-mod-api` dependency at it, so rust-analyzer completes the API. The launcher replaces it when it builds."
        },
        "inox.mixinsRevision": {
          "type": "string",
          "default": "",
          "pattern": "^([0-9a-f]{40})?$",
          "markdownDescription": "The horizon-mixins commit written in built `.hnmod`s. Empty: the one the launcher uses."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "horizon-native.json",
        "url": "./schemas/horizon-native.schema.json"
      },
      {
        "fileMatch": "**/data/*/horizon/block/*.json",
        "url": "./schemas/hmod-block.schema.json"
      },
      {
        "fileMatch": "**/data/*/horizon/item/*.json",
        "url": "./schemas/hmod-item.schema.json"
      },
      {
        "fileMatch": "**/data/*/horizon/mob_effect/*.json",
        "url": "./schemas/hmod-mob-effect.schema.json"
      },
      {
        "fileMatch": "**/data/*/horizon/creative_tab/*.json",
        "url": "./schemas/hmod-creative-tab.schema.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "package": "vsce package --allow-missing-repository",
    "sync-hooks": "node scripts/sync-hooks.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "ajv": "^8.17.1"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  }
}
